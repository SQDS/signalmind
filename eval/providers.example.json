  "kimi":     {"base_url": "<anthropic-compatible base URL>", "api_key_env": "KIMI_API_KEY", "model": "<model name>", "vision": false, "price_in": 0.0, "price_out": 0.0},
  "glm":      {"base_url": "<anthropic-compatible base URL>", "api_key_env": "GLM_API_KEY", "model": "<model name>", "vision": false, "price_in": 0.0, "price_out": 0.0},
  "qwen":     {"base_url": "<anthropic-compatible base URL>", "api_key_env": "QWEN_API_KEY", "model": "<model name>", "vision": false, "price_in": 0.0, "price_out": 0.0}
