{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SignalMind proposed ActionPlan",
  "$comment": "Development handoff only. No production compatibility claimed. Semantic and operator-specific validation is required.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_schema_version",
    "plan_status",
    "case_id",
    "input_hash",
    "parent_version_id",
    "profile_id",
    "diagnoses",
    "actions",
    "needs_evidence",
    "summary"
  ],
  "properties": {
    "plan_schema_version": {
      "const": "proposal.v1"
    },
    "plan_status": {
      "const": "proposed"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "input_hash": {
      "type": "string",
      "minLength": 1
    },
    "parent_version_id": {
      "type": "string",
      "minLength": 1
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "diagnoses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "hypothesis",
          "evidence_refs",
          "uncertainty"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "hypothesis": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "uncertainty": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_id",
          "kind",
          "operator_id",
          "operator_version",
          "parameters",
          "read_ranges",
          "write_ranges",
          "expected_effect",
          "stop_conditions"
        ],
        "properties": {
          "action_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "preserve",
              "invoke_registered_operator",
              "mark_unusable",
              "propose_event_amendment"
            ]
          },
          "operator_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "operator_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "parameters": {
            "type": "object"
          },
          "read_ranges": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/sample_range"
            }
          },
          "write_ranges": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/sample_range"
            }
          },
          "expected_effect": {
            "type": "string",
            "minLength": 1
          },
          "stop_conditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "invoke_registered_operator"
                }
              }
            },
            "then": {
              "properties": {
                "operator_id": {
                  "type": "string",
                  "minLength": 1
                },
                "operator_version": {
                  "type": "string",
                  "minLength": 1
                },
                "write_ranges": {
                  "minItems": 1
                },
                "read_ranges": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "preserve",
                    "mark_unusable",
                    "propose_event_amendment"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "write_ranges": {
                  "maxItems": 0
                },
                "operator_id": {
                  "type": "null"
                },
                "operator_version": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "propose_event_amendment"
                }
              }
            },
            "then": {
              "properties": {
                "parameters": {
                  "required": [
                    "declared_changes"
                  ],
                  "properties": {
                    "declared_changes": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "needs_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "sample_range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel_id",
        "start_sample",
        "end_sample"
      ],
      "properties": {
        "channel_id": {
          "type": "string",
          "minLength": 1
        },
        "start_sample": {
          "type": "integer",
          "minimum": 0
        },
        "end_sample": {
          "type": "integer",
          "minimum": 1
        }
      },
      "description": "Global half-open sample range; end > start and bounds are runtime semantic checks."
    }
  }
}
