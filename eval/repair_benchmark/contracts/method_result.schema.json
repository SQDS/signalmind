{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SignalMind proposed MethodResult",
  "$comment": "No hidden-reference scores in public MethodResult. Artifact existence, mask semantics and actual hash checks belong to executor.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result_schema_version",
    "case_id",
    "arm_id",
    "run_id",
    "input_hash",
    "parent_version_id",
    "status",
    "decision",
    "fallback_used",
    "selected_candidate",
    "released_waveform",
    "validity_mask",
    "provenance_mask",
    "native_measurements",
    "derived_measurements",
    "trace",
    "reason_codes",
    "usage",
    "provider_receipt"
  ],
  "properties": {
    "result_schema_version": {
      "const": "proposal.v1"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "arm_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "input_hash": {
      "type": "string",
      "minLength": 1
    },
    "parent_version_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "completed",
        "abstained",
        "invalid_output",
        "timeout",
        "budget_exhausted",
        "error"
      ]
    },
    "decision": {
      "enum": [
        "preserve",
        "waveform_repair",
        "mark_unusable",
        "event_amendment",
        "need_evidence"
      ]
    },
    "fallback_used": {
      "type": "boolean"
    },
    "selected_candidate": {
      "anyOf": [
        {
          "$ref": "#/$defs/artifact"
        },
        {
          "type": "null"
        }
      ]
    },
    "released_waveform": {
      "anyOf": [
        {
          "$ref": "#/$defs/artifact"
        },
        {
          "type": "null"
        }
      ]
    },
    "validity_mask": {
      "anyOf": [
        {
          "$ref": "#/$defs/artifact"
        },
        {
          "type": "null"
        }
      ]
    },
    "provenance_mask": {
      "anyOf": [
        {
          "$ref": "#/$defs/artifact"
        },
        {
          "type": "null"
        }
      ]
    },
    "native_measurements": {
      "anyOf": [
        {
          "$ref": "#/$defs/artifact"
        },
        {
          "type": "null"
        }
      ]
    },
    "derived_measurements": {
      "anyOf": [
        {
          "$ref": "#/$defs/artifact"
        },
        {
          "type": "null"
        }
      ]
    },
    "trace": {
      "anyOf": [
        {
          "$ref": "#/$defs/artifact"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_requests",
        "tool_calls",
        "input_tokens",
        "output_tokens",
        "reasoning_tokens",
        "cached_input_tokens",
        "usd_cost",
        "wall_seconds",
        "unknown_fields"
      ],
      "properties": {
        "model_requests": {
          "type": "integer",
          "minimum": 0
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "reasoning_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cached_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "usd_cost": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "wall_seconds": {
          "type": "number",
          "minimum": 0
        },
        "unknown_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "provider_receipt": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "base_url",
            "requested_model_id",
            "returned_model_id",
            "request_ids"
          ],
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "base_url": {
              "type": "string",
              "minLength": 1
            },
            "requested_model_id": {
              "type": "string",
              "minLength": 1
            },
            "returned_model_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "request_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "sha256",
        "kind"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "kind": {
          "enum": [
            "waveform",
            "validity_mask",
            "provenance_mask",
            "native_measurements",
            "derived_measurements",
            "event_table",
            "trace"
          ]
        }
      }
    }
  }
}
